rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /slidePuzzleScores/{scoreId} {
      // Anyone can view the public leaderboard.
      allow read: if true;

      // A player never sees a login screen, but the app signs them in
      // anonymously before submitting a score.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'game', 'version', 'name', 'timeMs', 'moves', 'createdAt'
        ])
        && request.resource.data.game == 'survivor-5-piece'
        && request.resource.data.version == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.timeMs is int
        && request.resource.data.timeMs >= 3000
        && request.resource.data.timeMs <= 3600000
        && request.resource.data.moves is int
        && request.resource.data.moves >= 44
        && request.resource.data.moves <= 5000
        && request.resource.data.createdAt == request.time;

      // Scores are immutable from the public app. Delete inappropriate or
      // suspicious entries from the Firebase console as the project owner.
      allow update, delete: if false;
    }
  }
}
